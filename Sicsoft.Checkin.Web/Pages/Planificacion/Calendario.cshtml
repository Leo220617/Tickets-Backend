@page
@model Tickets.Pages.Planificacion.CalendarioModel

@using System
@using System.Linq
@using Newtonsoft.Json

@{
    ViewData["Title"] = "Planificación";

    var actividades = Model.Calendario ??
        Array.Empty<Tickets.Models.ActividadesViewModel>();

    var empresas = Model.ObjetoClientes ??
        Array.Empty<Tickets.Models.EmpresasViewModel>();

    var tipos = Model.ObjetoTA ??
        Array.Empty<Tickets.Models.TipoActividadesViewModel>();

    var usuarios = Model.Usuarios ??
        Array.Empty<InversionGloblalWeb.Models.UsuariosViewModel>();

    var usuariosJson = usuarios
        .OrderBy(u => u.Nombre)
        .Select(u => new
        {
            id = u.id,
            nombre = u.Nombre
        });
}

@section styles {
    <style>
        :root {
            --calendar-navy: #131e29;
            --calendar-blue: #0073bb;
            --calendar-orange: #ff9900;
            --calendar-border: #d5dbdb;
            --calendar-muted: #5f6b7a;
            --calendar-background: #f2f3f3;
            --calendar-success: #1f7a45;
            --calendar-danger: #b12704;
        }

        body {
            background: var(--calendar-background);
        }

        .planning-page {
            padding: 22px;
        }

        .planning-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 20px;
            padding: 22px 26px;
            border-radius: 9px;
            background: linear-gradient(125deg, #131e29, #22384d);
            color: #fff;
            box-shadow: 0 3px 10px rgba(19, 30, 41, .18);
        }

        .planning-eyebrow {
            margin-bottom: 4px;
            color: #aab7b8;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .1em;
            text-transform: uppercase;
        }

        .planning-title {
            margin: 0;
            color: #fff !important;
            font-size: 27px;
            font-weight: 700;
        }

        .planning-subtitle {
            margin: 6px 0 0;
            color: #d5dbdb;
            font-size: 14px;
        }

        .btn-new-task {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 42px;
            padding: 0 18px;
            border: 1px solid #e47911;
            border-radius: 5px;
            background: linear-gradient(#ffad33, #ff9900);
            color: #161e2d;
            font-weight: 700;
            cursor: pointer;
        }

            .btn-new-task:hover {
                background: linear-gradient(#ffa41c, #f08804);
            }

        .planning-card {
            border: 1px solid var(--calendar-border);
            border-radius: 8px;
            background: #fff;
            box-shadow: 0 1px 3px rgba(19, 30, 41, .08);
        }

        .planning-toolbar {
            display: grid;
            grid-template-columns: minmax(210px, 280px) minmax(210px, 280px) minmax(300px, 1fr);
            gap: 16px;
            align-items: end;
            padding: 18px 20px;
            border-bottom: 1px solid var(--calendar-border);
        }

        .planning-field label {
            display: block;
            margin-bottom: 6px;
            color: #34465a;
            font-size: 13px;
            font-weight: 700;
        }

        .planning-field .form-control {
            min-height: 42px;
            border-color: #aab7b8;
        }

        .legend-list {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            min-height: 42px;
            align-items: center;
        }

        .legend-user {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 9px;
            border: 1px solid #d5dbdb;
            border-radius: 999px;
            background: #fff;
            color: #34465a;
            font-size: 11px;
            font-weight: 600;
        }

        .legend-color {
            flex: 0 0 10px;
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .legend-status {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 8px;
            color: #5f6b7a;
            font-size: 11px;
        }

        .legend-status-item {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .calendar-container {
            padding: 20px;
        }

        .fc .fc-toolbar-title {
            color: #263442;
            font-size: 21px;
            font-weight: 700;
        }

        .fc .fc-button-primary {
            border-color: #005a8c;
            background: #0073bb;
        }

            .fc .fc-button-primary:hover {
                background: #005a8c;
            }

        .fc .fc-daygrid-day-frame {
            min-height: 125px;
        }

        .fc .fc-col-header-cell {
            padding: 9px 4px;
            background: #f7f8f8;
            color: #34465a;
        }

        .fc .fc-daygrid-day-number {
            color: #34465a;
            font-weight: 700;
            text-decoration: none;
        }

        .fc .fc-day-today {
            background: #fff8e8 !important;
        }

        .fc-daygrid-event {
            margin: 3px 5px !important;
            padding: 5px 7px !important;
            border: 0 !important;
            border-radius: 5px !important;
            font-size: 12px !important;
            font-weight: 600;
            cursor: pointer;
        }

            .fc-daygrid-event .fc-event-title {
                overflow: hidden;
                white-space: normal !important;
            }

        .task-detail {
            text-align: left;
        }

        .task-detail-row {
            margin-bottom: 9px;
            color: #34465a;
        }

        .task-consultant {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .task-consultant-color {
            display: inline-block;
            width: 11px;
            height: 11px;
            border-radius: 50%;
        }

        .task-status {
            display: inline-block;
            margin-bottom: 14px;
            padding: 4px 9px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }

        .task-status-pending {
            background: #eef7fc;
            color: #005a8c;
        }

        .task-status-complete {
            background: #edf8f1;
            color: #1f7a45;
        }

        .task-status-cancelled {
            background: #fff0ee;
            color: #b12704;
        }

        .swal-form {
            text-align: left;
        }

        .swal-field {
            margin-bottom: 13px;
        }

            .swal-field label {
                display: block;
                margin-bottom: 5px;
                color: #34465a;
                font-size: 13px;
                font-weight: 700;
            }

            .swal-field .swal2-input,
            .swal-field .swal2-select,
            .swal-field .swal2-textarea {
                width: 100%;
                margin: 0;
                box-sizing: border-box;
            }

        @@media (max-width: 1200px) {
            .planning-toolbar {
                grid-template-columns: 1fr 1fr;
            }

            .consultant-legend {
                grid-column: 1 / -1;
            }
        }

        @@media (max-width: 768px) {
            .planning-page {
                padding: 12px;
            }

            .planning-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .planning-toolbar {
                grid-template-columns: 1fr;
            }

            .consultant-legend {
                grid-column: auto;
            }

            .calendar-container {
                padding: 10px;
            }

            .fc .fc-toolbar {
                align-items: flex-start;
                flex-direction: column;
                gap: 10px;
            }
        }
    </style>
}

<form method="post" id="formCalendario">
    @Html.AntiForgeryToken()
</form>

<div class="planning-page">
    <header class="planning-header">
        <div>
            <div class="planning-eyebrow">Centro de planificación</div>

            <h1 class="planning-title">
                Asignación de actividades
            </h1>

            <p class="planning-subtitle">
                Organiza las tareas diarias del equipo y controla su cumplimiento.
            </p>
        </div>

        <button type="button" id="NuevaActividad" class="btn-new-task">
            <i class="fa fa-plus"></i>
            Nueva actividad
        </button>
    </header>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <section class="planning-card">
        <div class="planning-toolbar">
            <div class="planning-field">
                <label for="FiltroUsuario">
                    <i class="fa fa-user mr-1"></i>
                    Consultor
                </label>

                <select id="FiltroUsuario" class="form-control">
                    <option value="0">Todos los consultores</option>

                    @foreach (var usuario in usuarios.OrderBy(u => u.Nombre))
                    {
                        <option value="@usuario.id">
                            @usuario.Nombre
                        </option>
                    }
                </select>
            </div>

            <div class="planning-field">
                <label for="FiltroTipo">
                    <i class="fa fa-list mr-1"></i>
                    Tipo de actividad
                </label>

                <select id="FiltroTipo" class="form-control">
                    <option value="0">Todos los tipos</option>

                    @foreach (var tipo in tipos.OrderBy(t => t.nombre))
                    {
                        <option value="@tipo.id">
                            @tipo.nombre
                        </option>
                    }
                </select>
            </div>

         
        </div>

        <div class="calendar-container">
            <div id="calendar"></div>
        </div>
    </section>
</div>

@section scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const todosLosEventos =
        @Html.Raw(JsonConvert.SerializeObject(actividades));

            const usuariosCalendario =
        @Html.Raw(JsonConvert.SerializeObject(usuariosJson));

            const token = document.querySelector(
                '#formCalendario input[name="__RequestVerificationToken"]'
            ).value;

            const calendarElement =
                document.getElementById('calendar');

            function obtenerColorConsultor(idUsuario) {
                const colores = [
                    '#0073bb',
                    '#7b3fb4',
                    '#d97706',
                    '#0891b2',
                    '#db2777',
                    '#4f46e5',
                    '#0f766e',
                    '#9333ea',
                    '#c2410c',
                    '#0369a1',
                    '#be185d',
                    '#4338ca'
                ];

                const id =
                    parseInt(idUsuario, 10) || 0;

                const posicion =
                    Math.abs(id) % colores.length;

                return colores[posicion];
            }

            function obtenerIdUsuarioEvento(evento) {
                return evento.extendedProps.idUsuario ||
                    evento.extendedProps.IdUsuario ||
                    evento.extendedProps.idusuario ||
                    0;
            }

            function cargarLeyendaConsultores() {
                const html = usuariosCalendario
                    .map(function (usuario) {
                        const color =
                            obtenerColorConsultor(usuario.id);

                        return `
                                    <button type="button"
                                            class="legend-user"
                                            data-user-id="${usuario.id}"
                                            style="cursor:pointer;">
                                        <span class="legend-color"
                                              style="background:${color}">
                                        </span>

                                        ${escaparHtml(usuario.nombre)}
                                    </button>
                                `;
                    })
                    .join('');

                $('#LeyendaConsultores').html(html);
            }

            const calendar = new FullCalendar.Calendar(
                calendarElement,
                {
                    initialView: 'dayGridMonth',
                    locale: 'es',
                    height: 'auto',
                    firstDay: 1,
                    editable: true,
                    dayMaxEvents: 4,
                    nowIndicator: true,

                    headerToolbar: {
                        left: 'prev,next today',
                        center: 'title',
                        right: 'dayGridMonth,timeGridWeek,listWeek'
                    },

                    buttonText: {
                        today: 'Hoy',
                        month: 'Mes',
                        week: 'Semana',
                        list: 'Lista'
                    },

                    events: todosLosEventos,

                    dateClick: function (informacion) {
                        abrirFormularioActividad(
                            informacion.dateStr
                        );
                    },

                    eventClick: function (informacion) {
                        informacion.jsEvent.preventDefault();

                        mostrarDetalle(
                            informacion.event
                        );
                    },

                    eventDrop: function (informacion) {
                        actualizarFecha(
                            informacion.event,
                            informacion.revert
                        );
                    },

                    eventDidMount: function (informacion) {
                        const propiedades =
                            informacion.event.extendedProps;

                        const estado =
                            propiedades.estado || 'Pendiente';

                        const idUsuario =
                            obtenerIdUsuarioEvento(
                                informacion.event
                            );

                        let colorEvento =
                            obtenerColorConsultor(idUsuario);

                        if (estado === 'Realizado') {
                            colorEvento = '#1f7a45';
                        } else if (estado === 'Cancelado') {
                            colorEvento = '#b12704';
                        }

                        informacion.el.style.backgroundColor =
                            colorEvento;

                        informacion.el.style.borderColor =
                            colorEvento;

                        informacion.el.style.color =
                            '#ffffff';

                        informacion.el.title =
                            informacion.event.title;
                    }
                }
            );

            calendar.render();
            cargarLeyendaConsultores();

            $('#FiltroUsuario, #FiltroTipo').on(
                'change',
                aplicarFiltros
            );

            $(document).on(
                'click',
                '.legend-user',
                function () {
                    const idUsuario =
                        $(this).data('user-id');

                    $('#FiltroUsuario')
                        .val(idUsuario)
                        .trigger('change');
                }
            );

            $('#NuevaActividad').on('click', function () {
                const hoy =
                    formatoFechaApi(new Date());

                abrirFormularioActividad(hoy);
            });

            function aplicarFiltros() {
                const idUsuario =
                    parseInt(
                        $('#FiltroUsuario').val(),
                        10
                    );

                const idTipo =
                    parseInt(
                        $('#FiltroTipo').val(),
                        10
                    );

                const eventosFiltrados =
                    todosLosEventos.filter(function (evento) {
                        const eventoUsuario =
                            parseInt(
                                evento.idUsuario ||
                                (
                                    evento.extendedProps &&
                                    evento.extendedProps.idUsuario
                                ) ||
                                0,
                                10
                            );

                        const eventoTipo =
                            parseInt(
                                evento.idTipoActividad ||
                                (
                                    evento.extendedProps &&
                                    evento.extendedProps.tipo
                                ) ||
                                0,
                                10
                            );

                        const coincideUsuario =
                            idUsuario === 0 ||
                            eventoUsuario === idUsuario;

                        const coincideTipo =
                            idTipo === 0 ||
                            eventoTipo === idTipo;

                        return coincideUsuario &&
                            coincideTipo;
                    });

                calendar.removeAllEvents();
                calendar.addEventSource(
                    eventosFiltrados
                );
            }

            async function abrirFormularioActividad(fecha) {
                const resultado = await Swal.fire({
                    title: 'Nueva actividad',

                    html: `
                                <div class="swal-form">
                                    <div class="swal-field">
                                        <label>Fecha</label>

                                        <input type="date"
                                               id="ActividadFecha"
                                               class="swal2-input"
                                               value="${fecha}">
                                    </div>

                                    <div class="swal-field">
                                        <label>Consultor responsable</label>

                                        <select id="ActividadUsuario"
                                                class="swal2-select">
                                            <option value="">
                                                Seleccione un consultor
                                            </option>

        @foreach (var usuario in usuarios.OrderBy(u => u.Nombre))
        {
                                                    <option value="@usuario.id">
                @usuario.Nombre
                                                    </option>
        }
                                        </select>
                                    </div>

                                    <div class="swal-field">
                                        <label>Empresa</label>

                                        <select id="ActividadEmpresa"
                                                class="swal2-select">
                                            <option value="0">
                                                Sin empresa
                                            </option>

        @foreach (var empresa in empresas.OrderBy(e => e.Nombre))
        {
                                                    <option value="@empresa.id">
                @empresa.Nombre
                                                    </option>
        }
                                        </select>
                                    </div>

                                    <div class="swal-field">
                                        <label>Tipo de actividad</label>

                                        <select id="ActividadTipo"
                                                class="swal2-select">
                                            <option value="">
                                                Seleccione el tipo
                                            </option>

        @foreach (var tipo in tipos.OrderBy(t => t.nombre))
        {
                                                    <option value="@tipo.id">
                @tipo.nombre
                                                    </option>
        }
                                        </select>
                                    </div>

                                    <div class="swal-field">
                                        <label>Título</label>

                                        <input type="text"
                                               id="ActividadTitulo"
                                               class="swal2-input"
                                               placeholder="Descripción corta">
                                    </div>

                                    <div class="swal-field">
                                        <label>Comentario</label>

                                        <textarea id="ActividadComentario"
                                                  class="swal2-textarea"
                                                  placeholder="Detalles de la tarea"></textarea>
                                    </div>
                                </div>
                            `,

                    width: 620,
                    showCancelButton: true,
                    confirmButtonText: 'Asignar actividad',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#0073bb',

                    preConfirm: function () {
                        const actividad = {
                            fechaAgendada:
                                $('#ActividadFecha').val(),

                            idUsuario:
                                parseInt(
                                    $('#ActividadUsuario').val(),
                                    10
                                ),

                            idEmpresa:
                                parseInt(
                                    $('#ActividadEmpresa').val(),
                                    10
                                ) || 0,

                            idTipoActividad:
                                parseInt(
                                    $('#ActividadTipo').val(),
                                    10
                                ),

                            titulo:
                                $('#ActividadTitulo')
                                    .val()
                                    .trim(),

                            comentario:
                                $('#ActividadComentario')
                                    .val()
                                    .trim()
                        };

                        if (!actividad.fechaAgendada) {
                            Swal.showValidationMessage(
                                'Debe seleccionar la fecha.'
                            );

                            return false;
                        }

                        if (!actividad.idUsuario) {
                            Swal.showValidationMessage(
                                'Debe seleccionar el consultor.'
                            );

                            return false;
                        }

                        if (!actividad.idTipoActividad) {
                            Swal.showValidationMessage(
                                'Debe seleccionar el tipo.'
                            );

                            return false;
                        }

                        if (!actividad.titulo) {
                            Swal.showValidationMessage(
                                'Debe escribir el título.'
                            );

                            return false;
                        }

                        return actividad;
                    }
                });

                if (!resultado.isConfirmed) {
                    return;
                }

                guardarActividad(resultado.value);
            }

            function guardarActividad(actividad) {
                Swal.fire({
                    title: 'Asignando actividad',
                    allowOutsideClick: false,
                    didOpen: function () {
                        Swal.showLoading();
                    }
                });

                $.ajax({
                    type: 'POST',
                    url: window.location.pathname +
                        '?handler=Crear',
                    contentType: 'application/json',
                    data: JSON.stringify(actividad),

                    headers: {
                        RequestVerificationToken: token
                    }
                })
                    .done(function (respuesta) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Actividad asignada',
                            text: respuesta.mensaje,
                            confirmButtonColor: '#0073bb'
                        }).then(function () {
                            window.location.reload();
                        });
                    })
                    .fail(function (xhr) {
                        mostrarError(xhr);
                    });
            }

            function mostrarDetalle(evento) {
                const propiedades =
                    evento.extendedProps;

                const estado =
                    propiedades.estado || 'Pendiente';

                const idUsuario =
                    obtenerIdUsuarioEvento(evento);

                const colorConsultor =
                    obtenerColorConsultor(idUsuario);

                const claseEstado =
                    estado === 'Realizado'
                        ? 'task-status-complete'
                        : estado === 'Cancelado'
                            ? 'task-status-cancelled'
                            : 'task-status-pending';

                const botonRealizado =
                    estado !== 'Realizado'
                        ? `
                                    <button type="button"
                                            id="MarcarRealizado"
                                            class="btn btn-success btn-block mt-3">
                                        <i class="fa fa-check mr-2"></i>
                                        Marcar como realizada
                                    </button>
                                  `
                        : '';

                Swal.fire({
                    title: evento.title,

                    html: `
                                <div class="task-detail">
                                    <span class="task-status ${claseEstado}">
                                        ${estado}
                                    </span>

                                    <div class="task-detail-row">
                                        <strong>Fecha:</strong>
                                        ${formatearFecha(evento.start)}
                                    </div>

                                    <div class="task-detail-row task-consultant">
                                        <span class="task-consultant-color"
                                              style="background:${colorConsultor}">
                                        </span>

                                        <span>
                                            <strong>Consultor:</strong>
                                            ${escaparHtml(
                        propiedades.usuario ||
                        'Sin asignar'
                    )}
                                        </span>
                                    </div>

                                    <div class="task-detail-row">
                                        <strong>Empresa:</strong>
                                        ${escaparHtml(
                        propiedades.empresa ||
                        'Sin empresa'
                    )}
                                    </div>

                                    <div class="task-detail-row">
                                        <strong>Tipo:</strong>
                                        ${escaparHtml(
                        propiedades.actividad ||
                        'Actividad'
                    )}
                                    </div>

                                    <div class="task-detail-row">
                                        <strong>Comentario:</strong><br>
                                        ${escaparHtml(
                        propiedades.comentario || ''
                    )}
                                    </div>

                                    ${botonRealizado}
                                </div>
                            `,

                    showConfirmButton: false,
                    showCloseButton: true,

                    didOpen: function () {
                        $('#MarcarRealizado').on(
                            'click',
                            function () {
                                marcarRealizado(evento);
                            }
                        );
                    }
                });
            }

            function marcarRealizado(evento) {
                $.ajax({
                    type: 'POST',
                    url: window.location.pathname +
                        '?handler=MarcarRealizado',
                    contentType: 'application/json',

                    data: JSON.stringify({
                        id: parseInt(evento.id, 10)
                    }),

                    headers: {
                        RequestVerificationToken: token
                    }
                })
                    .done(function (respuesta) {
                        evento.setExtendedProp(
                            'estado',
                            'Realizado'
                        );

                        evento.setProp(
                            'backgroundColor',
                            '#1f7a45'
                        );

                        evento.setProp(
                            'borderColor',
                            '#1f7a45'
                        );

                        Swal.fire(
                            'Actividad realizada',
                            respuesta.mensaje,
                            'success'
                        );
                    })
                    .fail(function (xhr) {
                        mostrarError(xhr);
                    });
            }

            function actualizarFecha(evento, revertir) {
                $.ajax({
                    type: 'POST',
                    url: window.location.pathname +
                        '?handler=ActualizarFecha',
                    contentType: 'application/json',

                    data: JSON.stringify({
                        id: parseInt(evento.id, 10),
                        fecha: formatoFechaApi(evento.start)
                    }),

                    headers: {
                        RequestVerificationToken: token
                    }
                })
                    .done(function () {
                        Swal.fire({
                            icon: 'success',
                            title: 'Actividad reprogramada',
                            timer: 1100,
                            showConfirmButton: false
                        });
                    })
                    .fail(function (xhr) {
                        revertir();
                        mostrarError(xhr);
                    });
            }

            function formatoFechaApi(fecha) {
                const anio = fecha.getFullYear();

                const mes = String(
                    fecha.getMonth() + 1
                ).padStart(2, '0');

                const dia = String(
                    fecha.getDate()
                ).padStart(2, '0');

                return anio + '-' + mes + '-' + dia;
            }

            function formatearFecha(fecha) {
                return new Intl.DateTimeFormat(
                    'es-CR',
                    {
                        day: '2-digit',
                        month: '2-digit',
                        year: 'numeric'
                    }
                ).format(fecha);
            }

            function escaparHtml(valor) {
                return $('<div>')
                    .text(valor || '')
                    .html();
            }

            function mostrarError(xhr) {
                let mensaje =
                    'No fue posible completar la operación.';

                if (xhr.responseJSON &&
                    xhr.responseJSON.mensaje) {
                    mensaje =
                        xhr.responseJSON.mensaje;
                }

                Swal.fire(
                    'Error',
                    mensaje,
                    'error'
                );
            }
        });
    </script>
}