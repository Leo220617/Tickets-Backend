<form method="post" id="formTipos" enctype="multipart/form-data">
    <input type="hidden" asp-for="Tiquete.id" id="TicketId" />
    <input type="hidden"id="UrlIndexTiquetes"value="@Url.Page("./Index")" />
    <input type="hidden" asp-for="Tiquete.Duracion" id="Duracion" />
    <input type="hidden" asp-for="Tiquete.Adjunto" id="Adjunto" />

    <main class="support-page">

        <header class="support-header mb-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between">
                <div>
                    <div class="ticket-number">Solicitud de soporte #@Model.Tiquete.id</div>
                    <h2 class="mb-1 mt-1">@Model.Tiquete.Asunto</h2>
                    @{
                        var estadoTexto = "Espera";
                        var estadoClase = "status-waiting";

                        switch (Model.Tiquete.Status)
                        {
                            case "A":
                                estadoTexto = Model.Tiquete.FechaReapertura.HasValue
                                ? "Reabierto"
                                : "Abierto";

                                estadoClase = Model.Tiquete.FechaReapertura.HasValue
                                ? "status-reopened"
                                : "status-open";
                                break;

                            case "V":
                                estadoTexto = "Validación";
                                estadoClase = "status-validation";
                                break;

                            case "C":
                                estadoTexto = "Cerrado";
                                estadoClase = "status-closed";
                                break;
                        }
                    }

                    <div class="mt-2">
                        <span class="case-status @estadoClase">
                            @estadoTexto
                        </span>

                        @if (Model.Tiquete.Status == "A" &&
                        Model.Tiquete.FechaReapertura.HasValue)
                        {
                            <small class="reopen-date">
                                <i class="fa fa-history mr-1"></i>
                                @Model.Tiquete.FechaReapertura.Value.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        }
                    </div>
                </div>
                <a asp-page="./Index" class="btn btn-outline-secondary mt-3 mt-md-0">
                    <i class="fa fa-arrow-left mr-2"></i>Volver a tiquetes
                </a>
            </div>
        </header>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-lg-8">
                <section class="card support-card mb-4">
                    <div class="card-header d-flex align-items-center">
                        <span class="section-icon mr-3"><i class="fa fa-envelope-open"></i></span>
                        <div><h5 class="mb-0">Solicitud del usuario</h5><small class="text-muted">Mensaje original recibido</small></div>
                    </div>
                    <div class="card-body">
                        <div class="request-box correo-recibido">
                            @Html.Raw(Model.Tiquete.Mensaje)
                        </div>
                        <textarea asp-for="Tiquete.Mensaje" hidden readonly></textarea>
                    </div>
                </section>

                <section class="card support-card mb-4">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <span class="section-icon mr-3">
                                <i class="fa fa-comments"></i>
                            </span>
                            <div>
                                <h5 class="mb-0">Historial de respuestas</h5>
                                <small class="text-muted">Conversación del tiquete</small>
                            </div>
                        </div>
                        <span class="badge badge-secondary" id="contadorRespuestas">
                            @(Model.Respuestas == null ? 0 : Model.Respuestas.Length)
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="conversation" id="historialRespuestas">
                            <article class="message-row client">
                                <div class="message-avatar"><i class="fa fa-user"></i></div>
                                <div class="message-card">
                                    <div class="message-header d-flex justify-content-between align-items-start">
                                        <div>
                                            <strong>@Model.Tiquete.PersonaTicket</strong>
                                            <span class="message-type">Cliente</span>
                                            <div class="small text-muted">Correo original · @Model.Tiquete.Asunto</div>
                                        </div>
                                        <small class="text-muted">@Convert.ToDateTime(Model.Tiquete.FechaTicket).ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                    <div class="message-body correo-recibido">
                                        @Html.Raw(Model.Tiquete.Mensaje)
                                    </div>
                                </div>
                            </article>

                            @if (Model.Respuestas != null)
                            {
                                @foreach (var item in Model.Respuestas.OrderBy(a => a.FechaCreacion))
                                {
                                    var esCliente = item.idUsuario == null || item.idUsuario == 0;
                                    var usuario = Model.Usuarios == null ? null : Model.Usuarios.FirstOrDefault(a => a.id == item.idUsuario);
                                    var claseMensaje = item.EsNotaInterna ? "internal" : (esCliente ? "client" : "support");
                                    var autor = item.EsNotaInterna ? (usuario == null ? "Equipo de soporte" : usuario.Nombre) : (esCliente ? Model.Tiquete.PersonaTicket : (usuario == null ? "Soporte" : usuario.Nombre));

                                                    <article class="message-row @claseMensaje">
                                                        <div class="message-avatar">
                                                            <i class="fa @(item.EsNotaInterna ? "fa-lock" : (esCliente ? "fa-user" : "fa-headset"))"></i>
                                                        </div>
                                                        <div class="message-card">
                                                            <div class="message-header d-flex justify-content-between align-items-start">
                                                                <div>
                                                                    <strong>@autor</strong>
                                                                    <span class="message-type">
                                                        @(item.EsNotaInterna ? "Nota interna" : (esCliente ? "Cliente" : "Soporte"))
                                                                    </span>
                                                                </div>
                                                                <small class="text-muted">@item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small>
                                                            </div>
                                                            <div class="message-body">@Html.Raw(item.Respuesta)</div>
                                                        </div>
                                                    </article>
                                }
                            }
                        </div>
                    </div>
                </section>

                <section class="card support-card reply-card mb-4">
                    <div class="card-header d-flex align-items-center">
                        <span class="section-icon mr-3"><i class="fa fa-reply"></i></span>
                        <div><h5 class="mb-0">Responder solicitud</h5><small class="text-muted">Escribe una respuesta clara para el usuario</small></div>
                    </div>
                    <div class="card-body">
                        <div class="composer-tabs" role="tablist">
                            <button type="button" class="composer-tab active" data-target="respuestaPanel"><i class="fa fa-paper-plane mr-2"></i>Respuesta al cliente</button>
                            <button type="button" class="composer-tab" data-target="notasPanel"><i class="fa fa-lock mr-2"></i>Nota interna</button>
                        </div>
                        @*       asp-for="Tiquete.Respuesta"
                        asp-validation-for="Tiquete.Respuesta" *@
                        <div id="respuestaPanel" class="composer-panel active">
                            <div class="form-group">
    <label for="DestinatariosRespuesta" class="font-weight-bold">
        <i class="fa fa-envelope mr-1"></i>
        Destinatarios
    </label>

    <input type="text"
           id="DestinatariosRespuesta"
           name="destinatarios"
           class="form-control"
           value="@Model.Tiquete.PersonaTicket"
           placeholder="correo1@empresa.com; correo2@empresa.com"
           autocomplete="off" />

    <small class="form-text text-muted">
        Puede agregar varios correos separados por punto y coma o coma.
    </small>
</div>
                            <label for="inputRespuesta" class="font-weight-bold">Respuesta al cliente</label>
                            <div class="form-control reply-box message-editor"
                                 id="inputRespuesta"
                                 contenteditable="true"
                                 data-placeholder="Escribe tu respuesta. Puedes pegar imágenes con Ctrl+V…"></div>
                            <span class="text-danger"></span>
                            <small class="form-text text-muted">Este mensaje sí será visible para el cliente.</small>
                        </div>
                        <div id="notasPanel" class="composer-panel">
                            <div class="alert alert-warning py-2"><i class="fa fa-lock mr-2"></i>Solo el equipo de soporte puede ver esta información.</div>
                            <label for="inputComentarios" class="font-weight-bold">Nota interna</label>
                            <input type="hidden" asp-for="Tiquete.Comentarios" />
                            <textarea class="form-control reply-box" id="inputComentarios"
                                      placeholder="Agrega contexto, diagnóstico o próximos pasos para el equipo…"></textarea>
                            <small class="form-text text-muted">La nota se guardará en el historial de respuestas y no será enviada al cliente.</small>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="button" id="EnviarRespuesta" class="btn btn-primary px-4">
                                <i class="fa fa-paper-plane mr-2"></i>Enviar respuesta
                            </button>
                        </div>

                        <div class="mt-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="font-weight-bold mb-0">
                                    <i class="fa fa-paperclip mr-1"></i>
                                    Adjuntar archivos
                                </label>
                                <button type="button" class="btn btn-link btn-sm" onclick="abrirModalAdjuntos()">
                                    <i class="fa fa-paperclip mr-1"></i>Ver adjuntos actuales
                                </button>
                            </div>
                            <div class="dropzone" id="dropzoneForm">
                                <div class="fallback">
                                    <input name="file"
                                           type="file"
                                           multiple
                                           accept=".png,.jpg,.jpeg,.pdf,.xls,.xlsx,.doc,.docx,.csv" />
                                </div>
                            </div>

                            <small class="form-text text-muted">
                                Formatos permitidos: PDF, Excel, Word, CSV, PNG y JPG.
                                Máximo 5 archivos y 18 MB en total.
                            </small>
                        </div>
                    </div>
                </section>
            </div>

            <aside class="col-lg-4">
                <section class="card support-card mb-4">
                    <div class="card-header"><h5 class="mb-0">Información del tiquete</h5></div>
                    <div class="card-body">
                        <div class="mb-3"><span class="meta-label">Creado el</span><input class="form-control" asp-for="Tiquete.FechaTicket" type="date" readonly /></div>
                        @if (Model.Tiquete.FechaReapertura != null)
                        {
                            <div class="mb-3">
                                <span class="meta-label">Última reapertura</span>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text">
                                            <i class="fa fa-history"></i>
                                        </span>
                                    </div>
                                    <input class="form-control" value="@Model.Tiquete.FechaReapertura.Value.ToString("dd/MM/yyyy HH:mm")" readonly />
                                </div>
                            </div>
                        }
                        <div class="mb-3"><span class="meta-label">Solicitante</span><input class="form-control" asp-for="Tiquete.PersonaTicket" readonly /></div>
                        <div class="mb-3"><span class="meta-label">Asunto</span><input class="form-control" asp-for="Tiquete.Asunto" readonly /></div>

                        <div class="mb-3">
                            <label asp-for="Tiquete.idLoginAsignado" class="meta-label">Agente asignado</label>
                            @if (puedeAsignar)
                            {
                                        <select asp-for="Tiquete.idLoginAsignado" class="form-control">
                                            <option value="0">Seleccione un agente</option>
                                    @foreach (var item in Model.Usuarios)
                                    {
                                                        <option value="@item.id">@item.Nombre</option>
                                    }
                                        </select>
                            }
                            else
                            {
                                        <input asp-for="Tiquete.idLoginAsignado" type="hidden" />
                                        <input class="form-control" value="@(Model.Usuarios.FirstOrDefault(a => a.id == Model.Tiquete.idLoginAsignado)?.Nombre ?? "Sin asignar")" readonly />
                            }
                        </div>

                        <div class="mb-3">
                            <label asp-for="Tiquete.idEmpresa" class="meta-label">Empresa</label>
                            @if (puedeCambiarEmpresa)
                            {
                                        <select asp-for="Tiquete.idEmpresa" class="form-control">
                                            <option value="0">Seleccione una empresa</option>
                                    @foreach (var item in Model.Empresas)
                                    {
                                                        <option value="@item.id">@item.Nombre</option>
                                    }
                                        </select>
                            }
                            else
                            {
                                        <input asp-for="Tiquete.idEmpresa" type="hidden" />
                                        <input class="form-control" value="@(Model.Empresas.FirstOrDefault(a => a.id == Model.Tiquete.idEmpresa)?.Nombre ?? "Sin empresa")" readonly />
                            }
                        </div>

                        <div class="mb-3">
                            <label asp-for="Tiquete.Tipo" class="meta-label">Tipo</label>
                            <select asp-for="Tiquete.Tipo" class="form-control">
                                <option value="">Seleccione un tipo</option>
                                <option value="F">Facturación</option>
                                <option value="S">SAP</option>
                                <option value="D">Desarrollo</option>
                            </select>
                            <span asp-validation-for="Tiquete.Tipo" class="text-danger"></span>
                            <small class="form-text text-muted">Este campo es obligatorio para guardar, responder o agregar notas.</small>
                        </div>
                    </div>
                </section>

                <section class="card support-card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fa fa-clock-o mr-2 text-primary"></i>
                            Control de tiempo
                        </h5>
                    </div>

                    <div class="card-body">
                        <input type="hidden"
                               id="DuracionReal"
                               asp-for="Tiquete.DuracionReal" />

                        <input type="hidden"
                               id="DuracionEstimada"
                               asp-for="Tiquete.DuracionEstimada" />

                        <div class="mb-4">
                            <label class="meta-label">Tiempo acumulado</label>

                            <div id="TiempoAcumulado"
                                 class="alert alert-info text-center mb-0"
                                 style="font-size:22px; font-weight:bold;">
                                0 horas 0 minutos
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="meta-label">Tiempo invertido a agregar</label>

                            <div class="row">
                                <div class="col-6">
                                    <label for="TiempoHoras" class="small text-muted">
                                        Horas
                                    </label>
                                    <input type="number"
                                           id="TiempoHoras"
                                           name="TiempoHoras"
                                           class="form-control"
                                           min="0"
                                           max="999"
                                           step="1"
                                           value="0" />
                                </div>

                                <div class="col-6">
                                    <label for="TiempoMinutos" class="small text-muted">
                                        Minutos
                                    </label>
                                    <input type="number"
                                           id="TiempoMinutos"
                                           name="TiempoMinutos"
                                           class="form-control"
                                           min="0"
                                           max="59"
                                           step="1"
                                           value="0" />
                                </div>
                            </div>

                            <small class="form-text text-muted">
                                Este tiempo se sumará al tiempo acumulado al guardar.
                            </small>
                        </div>

                        <div>
                            <label class="meta-label">Duración estimada</label>

                            <div class="row">
                                <div class="col-6">
                                    <label for="EstimadoHoras" class="small text-muted">
                                        Horas
                                    </label>

                                    <input type="number"
                                           id="EstimadoHoras"
                                           name="EstimadoHoras"
                                           class="form-control"
                                           min="0"
                                           max="999"
                                           step="1"
                                           value="0" />
                                </div>

                                <div class="col-6">
                                    <label for="EstimadoMinutos" class="small text-muted">
                                        Minutos
                                    </label>

                                    <input type="number"
                                           id="EstimadoMinutos"
                                           name="EstimadoMinutos"
                                           class="form-control"
                                           min="0"
                                           max="59"
                                           step="1"
                                           value="0" />
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

            </aside>
        </div>

        <div class="sticky-actions">
            <div class="d-flex justify-content-end">
                @if (Roles.Contains("2"))
                {
                    <button type="button" id="UnificarTiquete" class="btn btn-outline-secondary mr-2">
                        <i class="fa fa-link mr-2"></i>Unificar tiquete
                    </button>
                }

                <a asp-page="./Index" class="btn btn-light mr-2">
                    Cancelar
                </a>

                <button type="button" id="GuardarCambios" class="btn btn-amazon px-4">
                    <i class="fa fa-save mr-2"></i>Guardar cambios
                </button>
            </div>
        </div>
    </main>
</form>

<div class="modal fade" id="modalAdjuntos" tabindex="-1" role="dialog" aria-labelledby="tituloAdjuntos" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloAdjuntos">
                    <i class="fa fa-paperclip mr-2"></i>
                    Adjuntos del tiquete
                </h5>
                <button type="button" class="close" aria-label="Cerrar" onclick="cerrarModalAdjuntos()">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="listaAdjuntos" class="lista-adjuntos"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="cerrarModalAdjuntos()">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalResultado" tabindex="-1" role="dialog" aria-labelledby="resultadoTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body text-center p-5">
                <i id="resultadoIcono" class="fa fa-check-circle text-success" style="font-size:4rem"></i>
                <h4 id="resultadoTitulo" class="mt-3 mb-2">Operación completada</h4>
                <p id="resultadoMensaje" class="text-muted mb-4"></p>
                <button type="button" class="btn btn-primary px-4" id="CerrarModalResultado">Aceptar</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
            <script src="~/lib/dropzone/dropzone.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
            <script src="~/js/Tickets/EditarTicket.js"></script>
    <script>
        window.abrirModalAdjuntos = function () {
            var modal = document.getElementById('modalAdjuntos');

            if (!modal) {
                console.error('No se encontró el modal de adjuntos.');
                return;
            }

            modal.style.display = 'block';
            modal.classList.add('show');
            modal.setAttribute('aria-hidden', 'false');

            document.body.classList.add('modal-open');

            var fondo = document.getElementById('fondoModalAdjuntos');

            if (!fondo) {
                fondo = document.createElement('div');
                fondo.id = 'fondoModalAdjuntos';
                fondo.className = 'modal-backdrop fade show';

                fondo.onclick = function () {
                    window.cerrarModalAdjuntos();
                };

                document.body.appendChild(fondo);
            }
        };

        window.cerrarModalAdjuntos = function () {
            var modal = document.getElementById('modalAdjuntos');

            if (modal) {
                modal.classList.remove('show');
                modal.style.display = 'none';
                modal.setAttribute('aria-hidden', 'true');
            }

            document.body.classList.remove('modal-open');

            var fondo = document.getElementById('fondoModalAdjuntos');

            if (fondo) {
                fondo.remove();
            }
        };

        document.addEventListener('keydown', function (evento) {
            if (evento.key === 'Escape') {
                window.cerrarModalAdjuntos();
            }
        });
    </script>
}


