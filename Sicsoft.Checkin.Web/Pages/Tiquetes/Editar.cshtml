@page "{id}"
@model Tickets.Pages.Tiquetes.EditarModel
@{
    ViewData["Title"] = "Atender solicitud";

    var rolesClaim = ((ClaimsIdentity)User.Identity).Claims
        .FirstOrDefault(c => c.Type == "Roles")?.Value ?? string.Empty;
    var Roles = rolesClaim.Split('|', StringSplitOptions.RemoveEmptyEntries);
    var puedeAsignar = Roles.Contains("3");
    var puedeCambiarEmpresa = Roles.Contains("14");
    var puedeEditarDuracionReal = Roles.Contains("17");
    var puedeReiniciarTiempo = Roles.Contains("5");
}

@using System
@using System.Linq
@using System.Security.Claims

@section styles {
    <link rel="stylesheet" href="~/lib/dropzone/basic.css" />
    <link rel="stylesheet" href="~/lib/dropzone/dropzone.css" />
    <style>
        body {
            background: #f2f3f3;
        }

        .support-page {
            max-width: 1500px;
            margin: 0 auto;
            padding: 0 1rem 3rem;
        }

        .console-bar {
            background: #131e29;
            color: #fff;
            margin: 0 -1rem 1rem;
            padding: .72rem 1.25rem;
            border-bottom: 3px solid #ff9900;
        }

        .console-brand {
            font-size: .95rem;
            font-weight: 700;
            letter-spacing: .02em;
        }

            .console-brand i {
                color: #ff9900;
            }

        .support-header {
            background: #fff;
            color: #161e2d;
            border: 1px solid #d5dbdb;
            border-radius: 3px;
            padding: 1rem 1.25rem;
            box-shadow: none;
        }

            .support-header .ticket-number {
                color: rgba(255,255,255,.72);
                font-size: .85rem;
                letter-spacing: .08em;
                text-transform: uppercase;
            }

            .support-header .ticket-number {
                color: #687078;
                letter-spacing: .03em;
            }

        .support-card {
            border: 1px solid #d5dbdb;
            border-radius: 3px;
            box-shadow: none;
            overflow: hidden;
        }

            .support-card .card-header {
                background: #fafafa;
                border-bottom: 1px solid #d5dbdb;
                padding: .8rem 1rem;
            }

            .support-card .card-body {
                padding: 1.25rem;
            }

        .section-icon {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 2px;
            background: #e7f1f7;
            color: #0073bb;
        }

        .meta-label {
            display: block;
            color: #718096;
            font-size: .76rem;
            font-weight: 700;
            letter-spacing: .04em;
            text-transform: uppercase;
            margin-bottom: .2rem;
        }

        .request-box {
            min-height: 260px;
            white-space: pre-wrap;
            background: #f8fafc;
            border: 1px solid #edf0f3;
            border-radius: 12px;
            padding: 1.25rem;
            color: #263442;
        }

        .reply-box {
            min-height: 240px !important;
            height: auto !important;
            border-radius: 10px;
        }

        .message-editor {
            display: block;
            width: 100%;
            min-height: 240px !important;
            height: auto !important;
            overflow: visible;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

            .message-editor img {
                display: block;
                max-width: 100%;
                height: auto;
                margin: 12px 0;
                border-radius: 6px;
            }

        .reply-card {
            border-top: 3px solid #ff9900;
        }

        .composer-tabs {
            display: flex;
            border-bottom: 1px solid #d5dbdb;
            margin: -1.25rem -1.25rem 1.25rem;
            background: #fafafa;
        }

        .composer-tab {
            border: 0;
            border-right: 1px solid #d5dbdb;
            background: transparent;
            padding: .8rem 1.2rem;
            color: #414d5c;
            font-weight: 600;
            cursor: pointer;
        }

            .composer-tab.active {
                color: #0073bb;
                background: #fff;
                box-shadow: inset 0 -3px #ff9900;
            }

        .composer-panel {
            display: none;
        }

            .composer-panel.active {
                display: block;
            }

        .case-status {
            display: inline-flex;
            align-items: center;
            background: #e6f6ed;
            color: #1d8102;
            border: 1px solid #a8d5ba;
            border-radius: 12px;
            padding: .18rem .65rem;
            font-size: .78rem;
            font-weight: 700;
        }

            .case-status:before {
                content: '';
                width: 7px;
                height: 7px;
                background: #1d8102;
                border-radius: 50%;
                margin-right: .4rem;
            }

        .btn-amazon {
            background: #ff9900;
            border-color: #e88b00;
            color: #161e2d;
            font-weight: 700;
        }

            .btn-amazon:hover {
                background: #ec8f00;
                color: #161e2d;
            }

        .timer {
            font-variant-numeric: tabular-nums;
            font-size: 2rem;
            font-weight: 700;
            color: #173b67;
            letter-spacing: .04em;
        }

        .timer-actions .btn {
            width: 42px;
            height: 38px;
        }

        .dropzone {
            border: 2px dashed #b8cad9;
            border-radius: 12px;
            background: #f8fbfd;
            min-height: 130px;
        }

        .sticky-actions {
            position: sticky;
            bottom: 0;
            z-index: 10;
            background: rgba(242,243,243,.97);
            border-top: 1px solid #d5dbdb;
            padding: 1rem 0;
            margin-top: 1.25rem;
        }

        .attachment-preview {
            width: 100%;
            max-height: 420px;
            object-fit: contain;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            background: #f8fafc;
        }

        .conversation {
            position: relative;
            padding-left: 46px;
        }

            .conversation:before {
                content: '';
                position: absolute;
                top: 8px;
                bottom: 8px;
                left: 18px;
                width: 2px;
                background: #d5dbdb;
            }

        .message-row {
            position: relative;
            margin-bottom: 1.1rem;
        }

        .message-avatar {
            position: absolute;
            left: -46px;
            top: 0;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: #687078;
            border: 3px solid #f2f3f3;
            z-index: 1;
        }

        .message-row.client .message-avatar {
            background: #526d82;
        }

        .message-row.support .message-avatar {
            background: #0073bb;
        }

        .message-row.internal .message-avatar {
            background: #ff9900;
            color: #161e2d;
        }

        .message-card {
            border: 1px solid #d5dbdb;
            border-radius: 3px;
            background: #fff;
        }

        .message-row.support .message-card {
            border-color: #8ac7e8;
            border-left: 5px solid #0073bb;
            background: #f2f9fd;
        }

        .message-row.client .message-card {
            border-color: #b8c7d1;
            border-left: 5px solid #526d82;
            background: #f5f7f9;
        }

        .message-row.internal .message-card {
            border-color: #f3c66d;
            border-left: 5px solid #ff9900;
            background: #fff8e7;
        }

        .message-header {
            padding: .75rem 1rem;
            border-bottom: 1px solid #eaeded;
            background: #fafafa;
        }

        .message-row.client .message-header {
            background: #e8eef2;
            color: #334b5c;
        }

        .message-row.support .message-header {
            background: #e5f3fa;
            color: #00689d;
        }

        .message-row.internal .message-header {
            background: #fff0c7;
            color: #6b4b00;
        }

        .message-type {
            display: inline-block;
            margin-left: .5rem;
            padding: .16rem .5rem;
            border-radius: 10px;
            font-size: .72rem;
            font-weight: 700;
        }

        .message-row.client .message-type {
            background: #526d82;
            color: #fff;
        }

        .message-row.support .message-type {
            background: #0073bb;
            color: #fff;
        }

        .message-row.internal .message-type {
            background: #ff9900;
            color: #161e2d;
        }

        .message-body {
            padding: 1rem;
            color: #263442;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

        .message-editor:empty:before {
            content: attr(data-placeholder);
            color: #8a949e;
            pointer-events: none;
        }

        .message-editor img,
        .message-body img {
            display: block;
            max-width: 100%;
            height: auto;
            margin: .75rem 0;
            border-radius: 6px;
        }
    </style>
}

<form method="post" id="formTipos" enctype="multipart/form-data">
    <input type="hidden" asp-for="Tiquete.id" id="TicketId" />
    <input type="hidden" asp-for="Tiquete.Duracion" id="Duracion" />
    <input type="hidden" asp-for="Tiquete.Adjunto" id="Adjunto" />

    <main class="support-page">

        <header class="support-header mb-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between">
                <div>
                    <div class="ticket-number">Solicitud de soporte #@Model.Tiquete.id</div>
                    <h2 class="mb-1 mt-1">@Model.Tiquete.Asunto</h2>
                    <div class="mt-2"><span class="case-status">Abierto</span></div>
                </div>
                <a asp-page="./Index" class="btn btn-outline-secondary mt-3 mt-md-0">
                    <i class="fa fa-arrow-left mr-2"></i>Volver a tiquetes
                </a>
            </div>
        </header>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-lg-8">
                <section class="card support-card mb-4">
                    <div class="card-header d-flex align-items-center">
                        <span class="section-icon mr-3"><i class="fa fa-envelope-open"></i></span>
                        <div><h5 class="mb-0">Solicitud del usuario</h5><small class="text-muted">Mensaje original recibido</small></div>
                    </div>
                    <div class="card-body">
                        <div class="request-box">@Model.Tiquete.Mensaje</div>
                        <textarea asp-for="Tiquete.Mensaje" hidden readonly></textarea>
                    </div>
                </section>

                <section class="card support-card mb-4">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <span class="section-icon mr-3">
                                <i class="fa fa-comments"></i>
                            </span>
                            <div>
                                <h5 class="mb-0">Historial de respuestas</h5>
                                <small class="text-muted">Conversación del tiquete</small>
                            </div>
                        </div>
                        <span class="badge badge-secondary" id="contadorRespuestas">
                            @(Model.Respuestas == null ? 0 : Model.Respuestas.Length)
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="conversation" id="historialRespuestas">
                            <article class="message-row client">
                                <div class="message-avatar"><i class="fa fa-user"></i></div>
                                <div class="message-card">
                                    <div class="message-header d-flex justify-content-between align-items-start">
                                        <div>
                                            <strong>@Model.Tiquete.PersonaTicket</strong>
                                            <span class="message-type">Cliente</span>
                                            <div class="small text-muted">Correo original · @Model.Tiquete.Asunto</div>
                                        </div>
                                        <small class="text-muted">@Convert.ToDateTime(Model.Tiquete.FechaTicket).ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                    <div class="message-body">@Model.Tiquete.Mensaje</div>
                                </div>
                            </article>

                            @if (Model.Respuestas != null)
                            {
                                @foreach (var item in Model.Respuestas.OrderBy(a => a.FechaCreacion))
                                {
                                    var esCliente = item.idUsuario == null || item.idUsuario == 0;
                                    var usuario = Model.Usuarios == null ? null : Model.Usuarios.FirstOrDefault(a => a.id == item.idUsuario);
                                    var claseMensaje = item.EsNotaInterna ? "internal" : (esCliente ? "client" : "support");
                                    var autor = item.EsNotaInterna ? (usuario == null ? "Equipo de soporte" : usuario.Nombre) : (esCliente ? Model.Tiquete.PersonaTicket : (usuario == null ? "Soporte" : usuario.Nombre));

                                    <article class="message-row @claseMensaje">
                                        <div class="message-avatar">
                                            <i class="fa @(item.EsNotaInterna ? "fa-lock" : (esCliente ? "fa-user" : "fa-headset"))"></i>
                                        </div>
                                        <div class="message-card">
                                            <div class="message-header d-flex justify-content-between align-items-start">
                                                <div>
                                                    <strong>@autor</strong>
                                                    <span class="message-type">
                                                        @(item.EsNotaInterna ? "Nota interna" : (esCliente ? "Cliente" : "Soporte"))
                                                    </span>
                                                </div>
                                                <small class="text-muted">@item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small>
                                            </div>
                                            <div class="message-body">@Html.Raw(item.Respuesta)</div>
                                        </div>
                                    </article>
                                }
                            }
                        </div>
                    </div>
                </section>

                <section class="card support-card reply-card mb-4">
                    <div class="card-header d-flex align-items-center">
                        <span class="section-icon mr-3"><i class="fa fa-reply"></i></span>
                        <div><h5 class="mb-0">Responder solicitud</h5><small class="text-muted">Escribe una respuesta clara para el usuario</small></div>
                    </div>
                    <div class="card-body">
                        <div class="composer-tabs" role="tablist">
                            <button type="button" class="composer-tab active" data-target="respuestaPanel"><i class="fa fa-paper-plane mr-2"></i>Respuesta al cliente</button>
                            <button type="button" class="composer-tab" data-target="notasPanel"><i class="fa fa-lock mr-2"></i>Nota interna</button>
                        </div>
                        @*       asp-for="Tiquete.Respuesta"
                        asp-validation-for="Tiquete.Respuesta" *@
                        <div id="respuestaPanel" class="composer-panel active">
                            <label for="inputRespuesta" class="font-weight-bold">Respuesta al cliente</label>
                            <div class="form-control reply-box message-editor"
                                 id="inputRespuesta"
                                 contenteditable="true"
                                 data-placeholder="Escribe tu respuesta. Puedes pegar imágenes con Ctrl+V…"></div>
                            <span class="text-danger"></span>
                            <small class="form-text text-muted">Este mensaje sí será visible para el cliente.</small>
                        </div>
                        <div id="notasPanel" class="composer-panel">
                            <div class="alert alert-warning py-2"><i class="fa fa-lock mr-2"></i>Solo el equipo de soporte puede ver esta información.</div>
                            <label for="inputComentarios" class="font-weight-bold">Nota interna</label>
                            <input type="hidden" asp-for="Tiquete.Comentarios" />
                            <textarea class="form-control reply-box" id="inputComentarios"
                                      placeholder="Agrega contexto, diagnóstico o próximos pasos para el equipo…"></textarea>
                            <small class="form-text text-muted">La nota se guardará en el historial de respuestas y no será enviada al cliente.</small>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="button" id="EnviarRespuesta" class="btn btn-primary px-4">
                                <i class="fa fa-paper-plane mr-2"></i>Enviar respuesta
                            </button>
                        </div>

                        <div class="mt-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="font-weight-bold mb-0">Adjuntar evidencia</label>
                                <button type="button" class="btn btn-link btn-sm" onclick="abrirModal()">
                                    <i class="fa fa-paperclip mr-1"></i>Ver adjuntos actuales
                                </button>
                            </div>
                            <div class="dropzone" id="dropzoneForm">
                                <div class="fallback"><input name="file" type="file" multiple /></div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <aside class="col-lg-4">
                <section class="card support-card mb-4">
                    <div class="card-header"><h5 class="mb-0">Información del tiquete</h5></div>
                    <div class="card-body">
                        <div class="mb-3"><span class="meta-label">Creado el</span><input class="form-control" asp-for="Tiquete.FechaTicket" type="date" readonly /></div>
                        <div class="mb-3"><span class="meta-label">Solicitante</span><input class="form-control" asp-for="Tiquete.PersonaTicket" readonly /></div>
                        <div class="mb-3"><span class="meta-label">Asunto</span><input class="form-control" asp-for="Tiquete.Asunto" readonly /></div>

                        <div class="mb-3">
                            <label asp-for="Tiquete.idLoginAsignado" class="meta-label">Agente asignado</label>
                            @if (puedeAsignar)
                            {
                                <select asp-for="Tiquete.idLoginAsignado" class="form-control">
                                    <option value="0">Seleccione un agente</option>
                                    @foreach (var item in Model.Usuarios)
                                    {
                                        <option value="@item.id">@item.Nombre</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input asp-for="Tiquete.idLoginAsignado" type="hidden" />
                                <input class="form-control" value="@(Model.Usuarios.FirstOrDefault(a => a.id == Model.Tiquete.idLoginAsignado)?.Nombre ?? "Sin asignar")" readonly />
                            }
                        </div>

                        <div class="mb-3">
                            <label asp-for="Tiquete.idEmpresa" class="meta-label">Empresa</label>
                            @if (puedeCambiarEmpresa)
                            {
                                <select asp-for="Tiquete.idEmpresa" class="form-control">
                                    <option value="0">Seleccione una empresa</option>
                                    @foreach (var item in Model.Empresas)
                                    {
                                        <option value="@item.id">@item.Nombre</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input asp-for="Tiquete.idEmpresa" type="hidden" />
                                <input class="form-control" value="@(Model.Empresas.FirstOrDefault(a => a.id == Model.Tiquete.idEmpresa)?.Nombre ?? "Sin empresa")" readonly />
                            }
                        </div>

                        <div class="mb-3">
                            <label asp-for="Tiquete.Tipo" class="meta-label">Tipo</label>
                            <select asp-for="Tiquete.Tipo" class="form-control">
                                <option value="">Seleccione un tipo</option>
                                <option value="F">Facturación</option>
                                <option value="S">SAP</option>
                                <option value="D">Desarrollo</option>
                            </select>
                            <span asp-validation-for="Tiquete.Tipo" class="text-danger"></span>
                            <small class="form-text text-muted">Este campo es obligatorio para guardar, responder o agregar notas.</small>
                        </div>
                    </div>
                </section>

                <section class="card support-card mb-4">
                    <div class="card-header"><h5 class="mb-0"><i class="fa fa-clock mr-2 text-primary"></i>Tiempo de atención</h5></div>
                    <div class="card-body text-center">
                        <div id="hms" class="timer mb-3">00:00:00</div>
                        <div class="timer-actions mb-4">
                            <button type="button" class="btn btn-success start" title="Iniciar"><i class="fa fa-play"></i></button>
                            <button type="button" class="btn btn-danger stop" title="Pausar"><i class="fa fa-stop"></i></button>
                            @if (puedeReiniciarTiempo)
                            {
                                <button type="button" class="btn btn-outline-secondary reiniciar" title="Reiniciar"><i class="fa fa-redo"></i></button>
                            }
                        </div>
                        <div class="text-left mb-3"><label asp-for="Tiquete.DuracionEstimada" class="meta-label">Duración estimada</label><input class="form-control" asp-for="Tiquete.DuracionEstimada" type="time" /></div>
                        @if (puedeEditarDuracionReal)
                        {
                            <div class="text-left"><label asp-for="Tiquete.DuracionReal" class="meta-label">Duración real</label><input class="form-control" id="DuracionReal" asp-for="Tiquete.DuracionReal" /></div>
                        }
                        else
                        {
                            <input type="hidden" id="DuracionReal" asp-for="Tiquete.DuracionReal" />
                        }
                    </div>
                </section>

            </aside>
        </div>

        <div class="sticky-actions">
            <div class="d-flex justify-content-end">
                <a asp-page="./Index" class="btn btn-light mr-2">Cancelar</a>
                <button type="button" id="GuardarCambios" class="btn btn-amazon px-4">
                    <i class="fa fa-save mr-2"></i>Guardar cambios
                </button>
            </div>
        </div>
    </main>
</form>

<div class="modal fade" id="modalAdjuntos" tabindex="-1" role="dialog" aria-labelledby="tituloAdjuntos" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="tituloAdjuntos">Adjuntos del tiquete</h5><button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button></div>
            <div class="modal-body"><div class="row"><div class="col-md-6 mb-3"><img src="" class="attachment-preview" id="src1" alt="Primer adjunto" /></div><div class="col-md-6 mb-3"><img src="" class="attachment-preview" id="src2" alt="Segundo adjunto" /></div></div></div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button></div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalResultado" tabindex="-1" role="dialog" aria-labelledby="resultadoTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body text-center p-5">
                <i id="resultadoIcono" class="fa fa-check-circle text-success" style="font-size:4rem"></i>
                <h4 id="resultadoTitulo" class="mt-3 mb-2">Operación completada</h4>
                <p id="resultadoMensaje" class="text-muted mb-4"></p>
                <button type="button" class="btn btn-primary px-4" id="CerrarModalResultado">Aceptar</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/lib/dropzone/dropzone.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/Tickets/EditarTicket.js"></script>
}


