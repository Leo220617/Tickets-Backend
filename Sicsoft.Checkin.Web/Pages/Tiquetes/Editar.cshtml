@page "{id}"
@model Tickets.Pages.Tiquetes.EditarModel
@{
    ViewData["Title"] = "Atender solicitud";

    var rolesClaim = ((ClaimsIdentity)User.Identity).Claims
        .FirstOrDefault(c => c.Type == "Roles")?.Value ?? string.Empty;
    var Roles = rolesClaim.Split('|', StringSplitOptions.RemoveEmptyEntries);
    var puedeAsignar = Roles.Contains("3");
    var puedeCambiarEmpresa = Roles.Contains("14");
    var puedeEditarDuracionReal = Roles.Contains("17");
    var puedeReiniciarTiempo = Roles.Contains("5");
}

@using System
@using System.Linq
@using System.Security.Claims

