        /* Tarjetas de archivos de Dropzone */
#dropzoneForm {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 14px;
    padding: 22px;
}

#dropzoneForm .dz-message {
    width: 100%;
    margin: 2rem 0;
}

#dropzoneForm .dz-preview {
    width: 150px;
    min-height: 185px;
    margin: 0;
    padding: 12px;
    border: 1px solid #d5dbdb;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 2px 5px rgba(0, 0, 0, .08);
}

#dropzoneForm .dz-preview:hover {
    border-color: #0073bb;
    box-shadow: 0 3px 9px rgba(0, 115, 187, .16);
}

#dropzoneForm .dz-preview .dz-image {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 82px;
    height: 82px;
    margin: 0 auto 10px;
    border-radius: 10px;
    background: #f3f4f5;
    overflow: hidden;
}

#dropzoneForm .dz-preview .dz-image img {
    display: none;
}

/* Ícono principal del archivo */
.dz-file-icon {
    font-size: 48px;
}

.dz-file-icon.pdf {
    color: #d13212;
}

.dz-file-icon.excel {
    color: #1f7a45;
}

.dz-file-icon.word {
    color: #1769aa;
}

.dz-file-icon.csv {
    color: #14815d;
}

.dz-file-icon.image {
    color: #7b61a8;
}

.dz-file-icon.default {
    color: #687078;
}

/* Nombre del archivo */
#dropzoneForm .dz-preview .dz-details {
    position: static;
    min-width: 0;
    padding: 0;
    color: #34465a;
    opacity: 1;
    text-align: center;
}

#dropzoneForm .dz-preview .dz-details .dz-size {
    margin: 0 0 6px;
    font-size: 12px;
    color: #687078;
}

#dropzoneForm .dz-preview .dz-details .dz-filename {
    max-width: 100%;
    font-size: 12px;
    font-weight: 600;
}

#dropzoneForm .dz-preview .dz-details .dz-filename span {
    display: block;
    overflow: hidden;
    padding: 0;
    border: 0;
    background: transparent;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Ocultar controles visuales que solo sirven para carga automática */
#dropzoneForm .dz-preview .dz-progress,
#dropzoneForm .dz-preview .dz-success-mark,
#dropzoneForm .dz-preview .dz-error-mark,
#dropzoneForm .dz-preview .dz-error-message {
    display: none;
}

/* Botón eliminar */
#dropzoneForm .dz-preview .dz-remove {
    display: block;
    margin-top: 10px;
    padding: 5px 8px;
    border: 1px solid #d13212;
    border-radius: 4px;
    color: #d13212;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
}

#dropzoneForm .dz-preview .dz-remove:hover {
    background: #d13212;
    color: #fff;
}

media (max-width: 576px) {
    #dropzoneForm .dz-preview {
        width: calc(50% - 8px);
    }
}

